# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Local MySQL (docker-compose.yml) ---
MYSQL_DATABASE=beone
MYSQL_USER=beone
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3307

# --- Backend (backend/src/main/resources/application.yml) ---
DB_URL=jdbc:mysql://localhost:3307/beone
DB_USERNAME=beone
DB_PASSWORD=change-me

# --- CODEF (server-side only; never put these in android/ or frontend/) ---
# Not used yet. Reserved for the CODEF integration work.
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
